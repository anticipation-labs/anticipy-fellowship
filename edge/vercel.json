{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/internal", "destination": "/_blocked" },
    { "source": "/internal/:path*", "destination": "/_blocked" },
    { "source": "/internal.html", "destination": "/_blocked" },
    { "source": "/fellows/hq", "destination": "/_blocked" },

    { "source": "/", "destination": "https://anticipy-fellowships.omar-114.workers.dev/fellowships.html" },
    { "source": "/fellowships", "destination": "https://anticipy-fellowships.omar-114.workers.dev/fellowships.html" },
    { "source": "/fellowship-growth-learning", "destination": "https://anticipy-fellowships.omar-114.workers.dev/fellowship-growth-learning.html" },

    { "source": "/:path*", "destination": "https://anticipy-fellowships.omar-114.workers.dev/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "microphone=(), camera=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
      ]
    }
  ]
}
